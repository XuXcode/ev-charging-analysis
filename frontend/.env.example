# All VITE_ values are public in the browser. Never put backend secrets here.
# Dashboard and stations read the existing FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional: without these, the local interactive boundary map still works.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JS_CODE=
# Production can use a security proxy instead of a browser security code.
VITE_AMAP_SECURITY_SERVICE_HOST=
# Optional, disabled by default. When enabled and the backend is unreachable, replay the read-only snapshot recorded in this repository
# (src/api/demo/offline-snapshot.js) and label it in the UI. Set to `off` to keep the real
# error states instead. HTTP 4xx and cancellations never activate the fallback.
VITE_DEMO_FALLBACK=off
