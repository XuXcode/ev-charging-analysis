APP_NAME=湖南充电空间分析数据服务
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
AMAP_WEBSERVICE_KEY=
# Passwords containing @ / : % must be URL encoded. Keep this file free of real credentials.
DATABASE_URL=mysql+pymysql://ev_app:replace_me@127.0.0.1:3306/ev_charging?charset=utf8mb4
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
# Pytest uses an independent MySQL database with a name ending in _test.
TEST_DATABASE_URL=mysql+pymysql://ev_app:replace_me@127.0.0.1:3306/ev_charging_test?charset=utf8mb4
